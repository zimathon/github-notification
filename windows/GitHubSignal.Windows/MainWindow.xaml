<Window x:Class="GitHubSignal.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitHub Signal" Width="460" Height="420" MinWidth="420" MinHeight="330" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" Background="#F5F7FA" Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,7">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ToggleButton" Content="開始" Click="Toggle_Click"/><Button Content="設定" Click="Settings_Click" Margin="0"/></StackPanel>
        <StackPanel><TextBlock Text="GitHub Signal" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Foreground="#52606D" FontSize="12"/></StackPanel>
      </DockPanel>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="OwnerFilter" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Owner_Changed" Margin="0,0,5,0" ToolTip="組織・ユーザー"/>
        <ComboBox x:Name="RepositoryFilter" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Filter_Changed" Margin="0,0,5,0" ToolTip="リポジトリ"/>
        <ComboBox x:Name="KindFilter" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Filter_Changed" ToolTip="通知の種類"/>
      </Grid>
      <DockPanel Margin="0,0,0,6"><CheckBox x:Name="ShowAcknowledged" DockPanel.Dock="Right" Content="確認済みも表示" VerticalAlignment="Center" Margin="8,0,0,0" Click="Filter_Changed"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="タイトル・投稿者で検索" AutomationProperties.Name="通知を検索"/></DockPanel>
      <Border x:Name="UpdateBanner" Background="#DFEEE5" Padding="6" Margin="0,0,0,6" Visibility="Collapsed"><Button x:Name="UpdateButton" Click="Update_Click" HorizontalAlignment="Stretch" Margin="0"/></Border>
      <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#A72B30" Margin="0,0,0,6" Visibility="Collapsed"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><Button DockPanel.Dock="Right" Content="終了" Click="Quit_Click" Margin="0"/><TextBlock x:Name="StatusLabel" FontSize="12" Foreground="#52606D" VerticalAlignment="Center"/></DockPanel>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ThreadList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                <StackPanel>
                  <TextBlock Text="{Binding Repository}" FontSize="12" Foreground="#52606D"/>
                  <Button Content="{Binding Title}" Tag="{Binding Url}" Click="Open_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#125EAD" FontWeight="SemiBold" Padding="0,4" Margin="0" ToolTip="GitHubで開く">
                    <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Button.ContentTemplate>
                  </Button>
                  <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#52606D" Margin="0,1,0,4"/>
                  <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="GitHubで開く" Tag="{Binding Url}" Click="Open_Click"/>
                    <Button Content="URLをコピー" Tag="{Binding Url}" Click="Copy_Click"/>
                    <Button Content="確認済み" Tag="{Binding Key}" Click="Acknowledge_Click" IsEnabled="{Binding HasPending}"/>
                    <Button Content="1時間後" Tag="{Binding Key}" Click="Snooze_Click" IsEnabled="{Binding HasPending}" ToolTip="1時間後に再通知"/>
                  </WrapPanel>
                  <Expander Header="{Binding DetailsLabel}" Margin="0,5,0,0" FontSize="12">
                    <ItemsControl ItemsSource="{Binding Signals}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="#E3E8ED" BorderThickness="0,1,0,0" Padding="0,7">
                        <StackPanel><TextBlock FontWeight="SemiBold"><Run Text="{Binding ActorLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TimeLabel, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,3,0,4"/><StackPanel Orientation="Horizontal"><Button Content="コメントを開く" Tag="{Binding Url}" Click="Open_Click"/><Button Content="URLをコピー" Tag="{Binding Url}" Click="Copy_Click"/></StackPanel></StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyLabel" Text="該当する通知はありません。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#52606D"/>
    </Grid>
  </DockPanel>
</Window>

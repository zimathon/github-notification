<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AssemblyName>GitHubSignal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GitHubSignal.Core/GitHubSignal.Core.csproj" />
    <Resource Include="Assets/AppIcon.ico" />
    <None Include="../../Resources/Octicons-LICENSE" Link="Octicons-LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
